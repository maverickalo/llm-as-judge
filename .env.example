# Environment variables for LLM Code Judge service
# Copy this file to .env and fill in your API keys

# OpenAI API key for GPT-4 evaluations
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key for Claude 3 evaluations
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google API key for Gemini Pro evaluations
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Vertex AI configuration for production use
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_REGION=us-central1

# Evaluation threshold (code must score above this to pass)
EVALUATION_THRESHOLD=70

# Optional: Custom baseline file path
# CUSTOM_BASELINE_PATH=./evaluation-baselines/custom-baseline.json

# Optional: Enable verbose logging
# VERBOSE=true